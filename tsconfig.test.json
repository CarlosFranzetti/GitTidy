{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom"],
    "lib": ["ES2023", "DOM"],
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "api/**/*.test.ts",
    "e2e/**/*.ts",
    "vitest.setup.ts"
  ],
  "exclude": []
}
