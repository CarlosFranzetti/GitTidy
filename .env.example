# Server-only. Never prefix with VITE_ — that would expose it to the browser.
OPENROUTER_API_KEY=

# Primary model. Keep the :free suffix to stay on the free tier.
OPENROUTER_MODEL=baidu/cobuddy:free

# Optional comma-separated fallback chain, tried in order when the primary
# rate limits or fails. Use ONLY :free models so this never costs money.
# Example: google/gemma-2-9b-it:free,mistralai/mistral-7b-instruct:free
OPENROUTER_FALLBACK_MODELS=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth scope. `repo` covers private repositories; `public_repo` drops private
# access entirely and is the safer choice if you only tidy public repos.
GITHUB_OAUTH_SCOPE=repo

# Optional. Sent to OpenRouter as HTTP-Referer.
PUBLIC_APP_URL=https://git-tidy.vercel.app
